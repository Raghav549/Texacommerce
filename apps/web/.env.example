# Server-only: Neon PostgreSQL connection URL. Apply npm run migrate first.
DATABASE_URL=postgresql://USER:PASSWORD@YOUR-NEON-HOST/DATABASE?sslmode=require
# Generate with: openssl rand -base64 32. Never prefix secrets with NEXT_PUBLIC_.
AUTH_SECRET=replace-with-a-random-secret
# Exact deployed origin; use the actual URL for each environment.
AUTH_URL=https://YOUR-PROJECT.vercel.app
# For Vercel / a trusted reverse proxy only.
AUTH_TRUST_HOST=true
# Leave false until migrations, seller operations, legal review, and real QA are complete.
# Cash on delivery only; this does not enable online payments.
MARKETPLACE_COD_ENABLED=false

# Optional password-recovery delivery. Server-only. Use a verified sending domain.
RESEND_API_KEY=
EMAIL_FROM=Texa <accounts@YOUR-VERIFIED-DOMAIN.example>
# AUTH_URL above must be your HTTPS application origin for reset links.
